# Select sandbox for testing; use production only when intentionally processing live sales.
square_environment=sandbox

# Square access tokens must remain server-side. Add the values to the ignored .env file.
square_access_token-sandbox=
square_location_id-sandbox=
square_access_token-prod=
square_location_id-prod=

# Email notifications for Contact and newsletter signup forms.
shake_contact_email=4showinvestments@gmail.com
shake_sender_email=
